{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/thank-you/*",
      "/contact/*",
      "/_next/*",
      "/favicon.ico",
      "/robots.txt",
      "/sitemap.xml",
      "/assets/*",
      "/api/*",
      "*.js",
      "*.css",
      "*.png",
      "*.jpg",
      "*.jpeg",
      "*.svg",
      "*.ico",
      "*.webp",
      "*.woff",
      "*.woff2",
      "*.txt"
    ]
  },
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  }
}
